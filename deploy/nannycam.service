[Unit]
Description=NannyCam motion-triggered recorder
After=multi-user.target

[Service]
Type=simple
User=spacecamel
WorkingDirectory=/home/spacecamel/NannyCam
ExecStart=/usr/bin/python3 /home/spacecamel/NannyCam/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
SupplementaryGroups=gpio video
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
